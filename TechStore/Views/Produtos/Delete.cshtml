@model TechStore.Models.Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="page-header">
    <h1>Excluir Produto</h1>
    <p>Confirme a exclusão do produto #@Model.Id</p>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">Confirmação de Exclusão</h5>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Tem certeza de que deseja excluir o produto <strong>@Html.DisplayFor(m => m.Nome)</strong>?
        </div>

        <dl class="row small">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Html.DisplayFor(m => m.Nome)</dd>

            <dt class="col-sm-3">Categoria</dt>
            <dd class="col-sm-9">
                <span class="badge badge-categoria">@Model.Categoria?.Nome ?? "Não informada"</span>
            </dd>

            <dt class="col-sm-3">Preço</dt>
            <dd class="col-sm-9">@Model.Preco.ToString("C")</dd>

            <dt class="col-sm-3">Estoque</dt>
            <dd class="col-sm-9">@Model.QuantidadeEstoque</dd>
        </dl>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
        <form asp-action="Delete" method="post">
            <button type="submit" class="btn btn-danger" onclick="return confirm('Tem certeza de que deseja excluir este produto?');">
                <i class="bi bi-trash3"></i> Excluir
            </button>
        </form>
    </div>
</div>
