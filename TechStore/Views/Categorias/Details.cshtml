@model TechStore.Models.Categoria

@{
    ViewData["Title"] = "Detalhes da Categoria";
}

<div class="page-header">
    <h1>Detalhes da Categoria</h1>
    <p>Visualização dos dados da categoria selecionada</p>
</div>

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Categoria #@Model.Id</span>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Nome</dd>

            <dt class="col-sm-3">Descrição</dt>
            <dd class="col-sm-9">
                @(!string.IsNullOrEmpty(Model.Descricao) ? Model.Descricao : "<span class=\"text-muted\">Não informada</span>")
            </dd>

            <dt class="col-sm-3">Produtos vinculados</dt>
            <dd class="col-sm-9">
                @if (Model.Produtos != null && Model.Produtos.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var produto in Model.Produtos.OrderBy(p => p.Nome))
                        {
                            <li>
                                <i class="bi bi-box me-1 text-primary"></i>
                                @produto.Nome
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <span class="text-muted">Nenhum produto vinculado.</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer text-end">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning me-2">
            <i class="bi bi-pencil"></i> Editar
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger" onclick="return confirm('Tem certeza de que deseja excluir esta categoria?');">
            <i class="bi bi-trash3"></i> Excluir
        </a>
    </div>
</div>
